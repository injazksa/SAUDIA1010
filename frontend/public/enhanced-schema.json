 {
 "@type": "Question",
 "name": "ما هي خدمات مكتب تأشيرات السعودية المعتمد؟",
 "acceptedAnswer": {
 "@type": "Answer",
 "text": "نقدم تأشيرات عمل سعودية لجميع المهن، تصديق الشهادات الجامعية والوثائق الرسمية، الاعتماد المهني (إنجاز)، وجميع خدمات السفارة السعودية في الأردن."
 }
 },
 {
 "@type": "Question",
 "name": "كم تستغرق معاملة تأشيرة العمل؟",
 "acceptedAnswer": {
 "@type": "Answer",
 "text": "تختلف المدة حسب نوع المعاملة واكتمال الوثائق ومتطلبات الجهة المختصة. تواصل مع المكتب لتأكيد المدة التقديرية للحالة المحددة."
 }
 },
 {
 "@type": "Question",
 "name": "هل المكتب معتمد من السفارة السعودية؟",
 "acceptedAnswer": {
 "@type": "Answer",
 "text": "نقدم دعمًا وتنسيقًا ومتابعة للمعاملات السعودية من الأردن. يحدد الاعتماد أو القبول النهائي وفق الجهة المختصة ونوع المعاملة."
 }
 },
 {
 "@type": "Question",
 "name": "ما هي المهن المتاحة للتأشيرات؟",
 "acceptedAnswer": {
 "@type": "Answer",
 "text": "تتضمن صفحة المهن سجلات متعددة لمهن إدارية واختصاصية وفنية وحرفية وعمالية. ابحث عن المسمى الوظيفي لمعرفة المتطلبات الأولية المرتبطة به."
 }
 },
 {
 "@type": "Question",
 "name": "هل تخدمون الشركات؟",
 "acceptedAnswer": {
 "@type": "Answer",
 "text": "نعم، نقدم خدمات تفويض شاملة للشركات السعودية لإنجاز تأشيرات موظفيها بسرعة ودقة."
 }
 }
